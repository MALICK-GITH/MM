# ---------------------------------------------------------------------------
# SKILL2CASH — variables d'environnement
# Copie ce fichier en `.env` puis remplis les valeurs.
# ---------------------------------------------------------------------------

# Base de données / Auth (PostgreSQL managé par Supabase ou auto-hébergé)
# Côté navigateur (injecté au build) :
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=xxxxxxxx

# Côté serveur (SSR + server functions) :
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=xxxxxxxx
# Clé de service (opérations privilégiées, JAMAIS exposée au navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging (FCM v1) pour les notifications push
# Obtenir ces credentials depuis: https://console.firebase.google.com/
# Paramètres du projet → Comptes de service → Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=notificationwork-53964
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@notificationwork-53964.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Assistant IA (facultatif). Compatible avec n'importe quelle passerelle OpenAI.
LOVABLE_API_KEY=

# Notifications Telegram (facultatif)
TELEGRAM_BOT_TOKEN=

# Portabilité : désactive la protection CSRF des server functions si le front
# et l'API sont servis depuis deux domaines différents.
DISABLE_CSRF=false

# Port d'écoute du serveur de production (par défaut 3000)
PORT=3000